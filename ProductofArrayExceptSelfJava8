import java.util.Arrays;
import java.util.*;
import java.util.stream.*;
class Main {
    public static void main(String[] args) {
        int[] num={1,2,3,4,5,6,7};
        int n=num.length;

       int[] newInt=IntStream.range(0,num.length)
       .map(i->IntStream.range(0,num.length)
       .filter(j->j!=i)
       .map(j->num[j])
       .reduce(1,(a,b)->a*b))
       .toArray();

   System.out.println(Arrays.toString(newInt));
    }
}
